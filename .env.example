# Copy to .env.local for local work, and set the same names in Vercel for production.
# Leave a value empty to switch that feature off. Nothing here is needed to run locally.

# Public address of the app, used in emailed links and on the QR codes.
APP_URL=http://localhost:3000

# At least 32 random characters. Signs participant cookies and personal plan links.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Database. Empty = the built-in local database in .data/pglite.
# Production: the Supabase connection string (Sydney, ap-southeast-2). Use the pooler on port 6543.
DATABASE_URL=

# Supabase Auth (staff magic links) and Realtime. Empty = local dev sign in and polling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend). Empty = emails are only logged, never sent.
RESEND_API_KEY=
EMAIL_FROM="ARM Hub <ai-adopt@your-armhub-domain>"

# HubSpot private app token (server only). Needs CRM companies, contacts, notes and tasks scopes.
HUBSPOT_PRIVATE_APP_TOKEN=

# Anthropic API for the optional AI helpers. Each event also has its own on/off switch (off by default).
ANTHROPIC_API_KEY=

# Shown on the privacy statement once confirmed.
PRIVACY_CONTACT_EMAIL=
